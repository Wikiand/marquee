    FILMS {
        INTEGER film_id PK "AUTOINCREMENT"
        TEXT title "NOT NULL, CHECK non-blank"
        INTEGER year "NOT NULL, CHECK greater than zero"
        TEXT description "NULLABLE"
        TEXT created_at "NOT NULL, UTC timestamp default"
    }

    GENRES {
        INTEGER genre_id PK "AUTOINCREMENT"
        TEXT name UK "NOT NULL, CHECK non-blank"
    }

    FILM_GENRES {
        INTEGER film_id PK, FK "NOT NULL, CASCADE on film delete"
        INTEGER genre_id PK, FK "NOT NULL, CASCADE on genre delete"
    }

    SCREENINGS {
        INTEGER screening_id PK "AUTOINCREMENT"
        INTEGER film_id FK "NOT NULL, CASCADE on film delete"
        TEXT venue "NOT NULL, CHECK non-blank"
        TEXT screening_time "NOT NULL"
    }

    FILMS ||--o{ FILM_GENRES : has
    GENRES ||--o{ FILM_GENRES : categorizes
    FILMS ||--o{ SCREENINGS : schedules

