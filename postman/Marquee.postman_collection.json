          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Updated genre name is returned', () => pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('testGenreName') + 'Updated'));"
                ]
              }
            }
          ]
        }
      ]
