        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/genres"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create test genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/genres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testGenreName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('testGenreName', 'MarqueeTestGenre' + stamp);",
                  "pm.collectionVariables.set('testFilmTitle', 'MarqueeTestFilm' + stamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 201', () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "pm.test('Response contains genreId', () => pm.expect(data.genreId).to.exist);",
                  "if (data.genreId !== undefined) pm.collectionVariables.set('genreId', String(data.genreId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get test genre",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/genres/{{genreId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Genre ID matches', () => pm.expect(String(pm.response.json().genreId)).to.eql(pm.collectionVariables.get('genreId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate genre name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/genres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testGenreName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Conflict uses error envelope', () => pm.expect(pm.response.json().error.code).to.eql(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update test genre",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/genres/{{genreId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testGenreName}}Updated\"\n}"
            }
